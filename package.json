{
  "name": "@tranbao0/printshop",
  "version": "1.0.0",
  "description": "Turns layouts into print-look images: photocopied zine pages, paper collages, ransom-note titles and animated SVGs.",
  "license": "MIT",
  "author": "Bao Tran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranbao0/printshop.git"
  },
  "type": "module",
  "bin": {
    "printshop": "bin/printshop.js"
  },
  "types": "./types/src/core/types.d.ts",
  "engines": {
    "node": ">=22.2.0"
  },
  "exports": {
    "./core/*": {
      "types": "./types/src/core/*.d.ts",
      "default": "./src/core/*.js"
    },
    "./packs/zine": {
      "types": "./types/packs/zine/index.d.ts",
      "default": "./packs/zine/index.js"
    },
    "./packs/collage": {
      "types": "./types/packs/collage/index.d.ts",
      "default": "./packs/collage/index.js"
    },
    "./packs/*": "./packs/*"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "templates",
    "examples",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "types": "node scripts/build-types.js",
    "types:check": "node scripts/build-types.js --check",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
